# ── Бэкстейдж: база данных ──────────────────────────────────────────────
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Telegram: авторизация и проверка платной подписки ────────────────────
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Username бота без @ (для Login Widget)
TELEGRAM_BOT_USERNAME=
# ID приватного канала (например -1001234567890) — на нём проверяется подписка
TELEGRAM_CHAT_ID=
# Ссылка-приглашение в приватный канал (кнопка «Оформить подписку»)
TELEGRAM_CHANNEL_LINK=

# ── Администраторы: Telegram ID или username через запятую ───────────────
ADMIN_IDS=

# ── Сервисные секреты (обязательны в продакшене!) ────────────────────────
# Подпись токенов чата. Должен совпадать с mini-services/chat-service
CHAT_SECRET=change-me
# Секрет внутренних вызовов между сервисами. Должен совпадать с chat-service
INTERNAL_SECRET=change-me-too
